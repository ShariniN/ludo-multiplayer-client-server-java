{
  "info": {
    "name": "LUDO-T Multi-Tier Server - HTTP Servlet Gateway Tests (COMP63038 A2)",
    "description": "Drives the LUDO-T game server through its servlets on embedded Apache Tomcat (port 8081). Run in order: it joins four HTTP players into room POSTMAN, which auto-starts a match, then exercises turn actions, state, events, chat, leaderboard (H2 database tier) and the queue metrics endpoint. Every request carries assertions. Start run_database.bat and run_server.bat first. Use the Collection Runner with many iterations on the 'Load' folder to flood the queue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8081" },
    { "key": "roomId", "value": "POSTMAN" },
    { "key": "redId", "value": "" },
    { "key": "greenId", "value": "" },
    { "key": "yellowId", "value": "" },
    { "key": "blueId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Queue metrics before load (GET /api/stats)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('8 worker threads and a 2000-slot bounded queue', () => { pm.expect(j.queue.workerThreads).to.eql(8); pm.expect(j.queue.capacity).to.eql(2000); });",
        "pm.test('nothing dropped', () => pm.expect(j.queue.dropped).to.eql(0));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/stats" }
    },
    {
      "name": "02 Join as RED (POST /api/room/join)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('joined via the request queue', () => pm.expect(j.status).to.eql('SUCCESS'));",
        "pm.test('assigned RED', () => pm.expect(j.assignedColor).to.eql('RED'));",
        "pm.collectionVariables.set('redId', j.clientId);"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "roomId", "value": "{{roomId}}" }, { "key": "playerName", "value": "Postman-Red" }, { "key": "preferredColor", "value": "RED" } ] },
        "url": "{{baseUrl}}/api/room/join" }
    },
    {
      "name": "03 Join as GREEN",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json(); pm.expect(j.assignedColor).to.eql('GREEN');",
        "pm.collectionVariables.set('greenId', j.clientId);"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "roomId", "value": "{{roomId}}" }, { "key": "playerName", "value": "Postman-Green" }, { "key": "preferredColor", "value": "GREEN" } ] },
        "url": "{{baseUrl}}/api/room/join" }
    },
    {
      "name": "04 Join as YELLOW",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json(); pm.expect(j.assignedColor).to.eql('YELLOW');",
        "pm.collectionVariables.set('yellowId', j.clientId);"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "roomId", "value": "{{roomId}}" }, { "key": "playerName", "value": "Postman-Yellow" }, { "key": "preferredColor", "value": "YELLOW" } ] },
        "url": "{{baseUrl}}/api/room/join" }
    },
    {
      "name": "05 Join as BLUE (4th player -> match auto-starts)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json(); pm.expect(j.assignedColor).to.eql('BLUE');",
        "pm.collectionVariables.set('blueId', j.clientId);"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "roomId", "value": "{{roomId}}" }, { "key": "playerName", "value": "Postman-Blue" }, { "key": "preferredColor", "value": "BLUE" } ] },
        "url": "{{baseUrl}}/api/room/join" }
    },
    {
      "name": "06 Room status (GET /api/room/status)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('four players seated and match started', () => { pm.expect(j.players).to.eql(4); pm.expect(j.started).to.be.true; });",
        "pm.test('RED has the first turn', () => pm.expect(j.activePlayer).to.eql('RED'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/room/status?roomId={{roomId}}" }
    },
    {
      "name": "07 GREEN rolls out of turn -> rejected (POST /api/game/roll)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
        "const j = pm.response.json();",
        "pm.test('server enforces turn order', () => { pm.expect(j.status).to.eql('REJECTED'); pm.expect(j.message).to.eql('Not your turn!'); });"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{greenId}}" } ] },
        "url": "{{baseUrl}}/api/game/roll" }
    },
    {
      "name": "08 RED rolls the dice (POST /api/game/roll)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('dice value in 1..6', () => { pm.expect(j.diceValue).to.be.within(1, 6); });",
        "pm.test('next step is a piece prompt or the turn passes', () => pm.expect(['SELECT_PIECE','ROLL_DICE','TURN_PASSED']).to.include(j.next));",
        "pm.collectionVariables.set('lastNext', j.next);",
        "pm.collectionVariables.set('lastPieces', j.validPieces || '');"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{redId}}" } ] },
        "url": "{{baseUrl}}/api/game/roll" }
    },
    {
      "name": "09 RED moves R1 (POST /api/game/move)",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "const pieces = pm.collectionVariables.get('lastPieces');",
          "pm.collectionVariables.set('piece', pieces ? pieces.split(',')[0] : 'R1');"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "const j = pm.response.json();",
          "if (pm.collectionVariables.get('lastNext') === 'SELECT_PIECE') {",
          "  pm.test('move accepted', () => { pm.response.to.have.status(200); pm.expect(j.status).to.eql('SUCCESS'); pm.expect(j.from).to.eql('BASE'); });",
          "} else {",
          "  pm.test('no piece was offered (roll was not a 6): move is ignored or rejected, never applied', () => pm.expect([202, 409]).to.include(pm.response.code));",
          "}"
        ] } }
      ],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{redId}}" }, { "key": "piece", "value": "{{piece}}" } ] },
        "url": "{{baseUrl}}/api/game/move" }
    },
    {
      "name": "10 Full board state (GET /api/game/state)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('16 tokens with a legal state each', () => { pm.expect(j.pieces).to.have.lengthOf(16); j.pieces.forEach(p => pm.expect(['BASE','ACTIVE','HOME_STRAIGHT','HOME']).to.include(p.state)); });",
        "pm.test('served by the embedded Apache Tomcat', () => pm.expect(j.serverType).to.include('Apache Tomcat'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/game/state?roomId={{roomId}}" }
    },
    {
      "name": "11 Drain RED's server events (GET /api/game/events)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('events include ROOM_JOINED, GAME_START and a DICE_ROLLED broadcast', () => { const t = j.events.map(e => e.type); pm.expect(t).to.include('ROOM_JOINED'); pm.expect(t).to.include('GAME_START'); pm.expect(t).to.include('DICE_ROLLED'); });"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/game/events?clientId={{redId}}" }
    },
    {
      "name": "11b Long-poll RED's events (GET /api/game/events?waitMs=2000)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('answered within the long-poll window', () => pm.expect(pm.response.responseTime).to.be.below(4000));",
        "pm.test('well-formed event list', () => pm.expect(pm.response.json().events).to.be.an('array'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/game/events?clientId={{redId}}&waitMs=2000" }
    },
    {
      "name": "12 Post chat (POST /api/chat)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('queued for broadcast', () => pm.expect(pm.response.json().status).to.eql('SUCCESS'));"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{blueId}}" }, { "key": "message", "value": "hello from Postman" } ] },
        "url": "{{baseUrl}}/api/chat" }
    },
    {
      "name": "13 Read chat (GET /api/chat)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('message is in the history', () => pm.expect(pm.response.text()).to.include('hello from Postman'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/chat" }
    },
    {
      "name": "14 Leaderboard from the database tier (GET /api/leaderboard)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('leaderboard array and match history are present', () => { pm.expect(j.leaderboard).to.be.an('array'); pm.expect(j).to.have.property('totalMatchesPlayed'); if (j.leaderboard.length > 0) { pm.expect(j.leaderboard[0].rank).to.eql(1); pm.expect(j.leaderboard[0]).to.have.property('winRate'); } });",
        "pm.test('source names the database tier', () => pm.expect(j.source).to.match(/DatabaseServer|file store/));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/leaderboard" }
    },
    {
      "name": "15 Unknown client is refused (401)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "not-a-session" } ] },
        "url": "{{baseUrl}}/api/game/roll" }
    },
    {
      "name": "16 Missing parameter is refused (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{redId}}" } ] },
        "url": "{{baseUrl}}/api/game/move" }
    },
    {
      "name": "Load (run this folder with 200+ iterations in the Collection Runner)",
      "item": [
        {
          "name": "L1 Rapid roll attempts from all four players",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('every request is answered (200 accepted, 409 out-of-turn, 202 queued)', () => pm.expect([200, 202, 409]).to.include(pm.response.code));"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{greenId}}" } ] },
            "url": "{{baseUrl}}/api/game/roll" }
        },
        {
          "name": "L2 Queue metrics after load (GET /api/stats)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('processed keeps up with enqueued and nothing is dropped', () => { pm.expect(j.queue.dropped).to.eql(0); pm.expect(j.queue.enqueued - j.queue.processed).to.be.below(2000); });"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/stats" }
        }
      ]
    },
    {
      "name": "99 Leave room (POST /api/room/leave)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "clientId", "value": "{{redId}}" } ] },
        "url": "{{baseUrl}}/api/room/leave" }
    }
  ]
}
